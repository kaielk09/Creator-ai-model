# Copy to .env and fill these values on your Node.js hosting panel.
NODE_ENV=production
PORT=3000
BASE_URL=https://purplecreator.pl
SESSION_SECRET=replace-with-a-long-random-secret
# 32-byte key encoded as 64 hexadecimal characters:
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
# SQLite database directory (must be writable by the Node process):
DATA_DIR=./data
